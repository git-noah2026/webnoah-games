// Cloudflare Workers: liefert den Ordner docs/ als statische Seite aus.
// Deploy: npx wrangler deploy (kein Build-Schritt nötig)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webnoah-games",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
